{
  "name": "statwise",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "export": "node -e \"const d=new Date().toISOString().slice(0,10);require(\\\"child_process\\\").execSync(\\\"npx sanity dataset export production ../exports/statwise-\\\"+d+\\\".tar.gz --overwrite\\\",{stdio:\\\"inherit\\\"})\"",
    "seed:categories": "sanity exec scripts/seed-categories.ts --with-user-token",
    "test:drafts": "sanity exec scripts/test-draft-privacy.ts --with-user-token"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/icons": "^5.2.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.21.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7",
    "@types/react": "^19.2.14",
    "eslint": "^10.8.1",
    "prettier": "^3.5",
    "typescript": "~6.0"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
