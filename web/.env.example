# Copy to .env for local development. In Cloudflare Pages, set these under
# Settings > Variables and Secrets. None of these values are secret.

# Sanity project (from sanity.io/manage). Public, read-only.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2025-02-19

# Never put a Sanity write/editor token or the Cloudflare deploy hook URL in this
# file or in the repo. The deploy hook lives only in Sanity's webhook settings.
