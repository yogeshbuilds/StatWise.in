---
import ListingPage from '../../../../components/ListingPage.astro';
import { getActiveCategories, getArticlesFull, type Category } from '../../../../lib/queries';
import { categoryUrl } from '../../../../lib/format';
import { pageCount } from '../../../../lib/paginate';
import { SITE } from '../../../../config/site';

export async function getStaticPaths() {
  const [categories, articles] = await Promise.all([getActiveCategories(), getArticlesFull()]);
  return categories.flatMap((category) => {
    const total = pageCount(articles.filter((a) => a.category?.slug === category.slug).length);
    return Array.from({ length: total - 1 }, (_, i) => ({
      params: { slug: category.slug, page: String(i + 2) },
      props: { category },
    }));
  });
}

const { category } = Astro.props as { category: Category };
const page = Number(Astro.params.page);
const articles = (await getArticlesFull()).filter((a) => a.category?.slug === category.slug);
---

<ListingPage
  title={category.name}
  kicker="Topic"
  intro={category.description}
  description={category.description || `${category.name} stories from ${SITE.name}.`}
  articles={articles}
  page={page}
  base={categoryUrl(category.slug)}
/>
