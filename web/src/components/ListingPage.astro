---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from './ArticleList.astro';
import type { ArticleCardData } from '../lib/queries';
import { pageCount, pageSlice } from '../lib/paginate';

// Shared by /stories/ and /category/<slug>/, including their /page/<n>/ variants.
interface Props {
  title: string;
  kicker: string;
  intro?: string;
  description: string;
  articles: ArticleCardData[];
  page: number;
  base: string;
}
const { title, kicker, intro, description, articles, page, base } = Astro.props;
const total = pageCount(articles.length);
---

<BaseLayout title={page > 1 ? `${title} — page ${page}` : title} description={description}>
  <div class="container">
    <header class="head">
      <p class="kicker">{kicker}</p>
      <h1>{title}</h1>
      {intro && <p class="intro">{intro}</p>}
    </header>
    {articles.length > 0 ? (
      <ArticleList articles={pageSlice(articles, page)} current={page} total={total} base={base} />
    ) : (
      <p>No stories published yet.</p>
    )}
  </div>
</BaseLayout>

<style>
  .head {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 3px solid var(--ink);
  }
  .head h1 { margin-bottom: 0.25rem; }
  .intro {
    margin: 0;
    max-width: var(--measure);
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: 1.1rem;
  }
</style>
