---
import { ADS } from '../config/site';

// One responsive AdSense display unit. Renders nothing until ADS.client and this slot ID are set.
interface Props {
  slot: keyof typeof ADS.slots;
}
const id = ADS.slots[Astro.props.slot];
---

{ADS.client && id && (
  <aside class="ad" aria-label="Advertisement">
    <p class="ad-label">Advertisement</p>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADS.client}
      data-ad-slot={id}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}

<style>
  .ad {
    max-width: var(--measure);
    margin: 2.5rem auto;
    padding-top: 0.4rem;
    border-top: 1px solid var(--rule);
    min-height: 280px; /* reserve space so the text below doesn't jump when the ad loads */
  }
  .ad-label {
    margin: 0 0 0.4rem;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
